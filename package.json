{
  "name": "incident-response-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc --noEmit false --outDir dist && tsc -p tsconfig.frontend.json && vite build --config vite.config.ts",
    "dev": "concurrently -k \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch backend/src/server.ts",
    "dev:web": "vite --config vite.config.ts",
    "test": "tsx --test tests/project.test.ts tests/backend.test.ts tests/memory.test.ts tests/analysis.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^20.17.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^9.2.4",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^8.3.1"
  },
  "dependencies": {
    "@vectorize-io/hindsight-client": "^0.10.1",
    "cors": "^2.8.6",
    "dotenv": "^18.0.4",
    "express": "^5.2.1",
    "groq-sdk": "^1.6.0",
    "lucide-react": "^1.48.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  }
}
